# ==============================================================================
# Invenpro Live Email OTP & System Notification Configuration
# Copy this file to ".env" in the project root.
# Restart the Django server after saving .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# LIVE EMAIL OTP & STAFF-TO-ADMIN FORGOT PASSWORD NOTIFICATIONS (via Gmail SMTP)
#    Steps:
#      1. Enable 2-Step Verification on your Google Account
#      2. Go to https://myaccount.google.com/apppasswords
#      3. Generate a 16-character App Password for "Invenpro"
#      4. Paste your Gmail address and 16-character App Password below (no spaces)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=Invenpro Security <your_email@gmail.com>
